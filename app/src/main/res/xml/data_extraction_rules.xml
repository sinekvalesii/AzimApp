<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: telefon değiştirildiğinde veya yeniden kurulumda ilerleme geri yüklenir. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="azim_store.xml" />
        <include domain="sharedpref" path="azim_reminders.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="azim_store.xml" />
        <include domain="sharedpref" path="azim_reminders.xml" />
    </device-transfer>
</data-extraction-rules>
